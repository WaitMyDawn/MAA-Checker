<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>yagen.waitmydawn.maa</groupId>
    <artifactId>maa-checker</artifactId>
    <!--
      版本号：用 Maven 的 CI-friendly ${revision}（本地默认 1.0.0；打包时可用 -Drevision=<版本> 覆盖）。
      这样 zip 名 / Release 名 / exe 右键属性里的版本三者天然一致，
      不会出现"产物版本与程序版本不一致"这种坑。
    -->
    <version>${revision}</version>
    <packaging>jar</packaging>
    <name>MAA Checker</name>
    <description>整合包可行性检验器：就地对已安装实例做"静态预检 → 自动启动 → 日志诊断 → 最小摘除/补装/升级 → 台账与还原"</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 版本号唯一来源：本地默认 1.0.0；打包脚本可用 -Drevision=x.y.z 覆盖 -->
        <revision>1.0.0</revision>
        <!-- 用本地仓库已有的版本，保证可以 -o 离线构建 -->
        <jackson.version>2.17.1</jackson.version>
        <junit.version>5.10.2</junit.version>
        <checker.sources>src/main/java</checker.sources>
        <checker.testSources>src/test/java</checker.testSources>
    </properties>

    <dependencies>
        <!-- 只用来解析实例版本 JSON / fabric.mod.json；TOML 用手写解析器（见 core/ModToml） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${checker.sources}</sourceDirectory>
        <testSourceDirectory>${checker.testSources}</testSourceDirectory>
        <finalName>maa-checker-cli-base</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- 默认产物只含 CLI；JavaFX 依赖和桌面入口不得混入 CLI jar。 -->
        <profile>
            <id>cli</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>cli-fat-jar</id>
                                <phase>package</phase>
                                <goals><goal>shade</goal></goals>
                                <configuration>
                                    <outputFile>${project.build.directory}/maa-checker-cli.jar</outputFile>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                                <exclude>module-info.class</exclude>
                                                <exclude>META-INF/versions/*/module-info.class</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <mainClass>yagen.waitmydawn.checker.CheckerCli</mainClass>
                                        </transformer>
                                    </transformers>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>com.akathist.maven.plugins.launch4j</groupId>
                        <artifactId>launch4j-maven-plugin</artifactId>
                        <version>2.5.0</version>
                        <executions>
                            <execution>
                                <id>cli-exe</id>
                                <phase>package</phase>
                                <goals><goal>launch4j</goal></goals>
                                <configuration>
                                    <headerType>console</headerType>
                                    <outfile>${project.build.directory}/MAA-Checker-CLI.exe</outfile>
                                    <jar>${project.build.directory}/maa-checker-cli.jar</jar>
                                    <errTitle>MAA-Checker CLI</errTitle>
                                    <classPath>
                                        <mainClass>yagen.waitmydawn.checker.CheckerCli</mainClass>
                                    </classPath>
                                    <jre>
                                        <minVersion>21</minVersion>
                                        <jdkPreference>preferJre</jdkPreference>
                                    </jre>
                                    <versionInfo>
                                        <fileVersion>${project.version}.0</fileVersion>
                                        <txtFileVersion>${project.version}</txtFileVersion>
                                        <productVersion>${project.version}.0</productVersion>
                                        <txtProductVersion>${project.version}</txtProductVersion>
                                        <fileDescription>MAA-Checker CLI</fileDescription>
                                        <copyright>Yagen</copyright>
                                        <productName>MAA-Checker CLI</productName>
                                        <internalName>MAA-Checker-CLI</internalName>
                                        <originalFilename>MAA-Checker-CLI.exe</originalFilename>
                                    </versionInfo>
                                    <messages>
                                        <jreVersionErr>MAA-Checker CLI 需要 Java 21 或更高版本。</jreVersionErr>
                                        <jreNotFoundErr>没有找到 Java 21+；请安装或使用桌面版。</jreNotFoundErr>
                                        <startupErr>MAA-Checker CLI 启动失败</startupErr>
                                    </messages>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- JavaFX 桌面构建。fat jar 仅作为 jpackage 输入，不替代桌面安装包。 -->
        <profile>
            <id>desktop</id>
            <properties>
                <javafx.version>21.0.11</javafx.version>
                <checker.sources>src</checker.sources>
                <checker.testSources>src</checker.testSources>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>${javafx.version}</version>
                </dependency>
            </dependencies>
            <build>
                <directory>target/desktop</directory>
                <finalName>maa-checker-desktop-base</finalName>
                <resources><resource><directory>src/desktop/resources</directory></resource></resources>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <version>3.13.0</version>
                        <configuration>
                            <includes><include>main/java/**/*.java</include><include>desktop/java/**/*.java</include></includes>
                            <testIncludes><testInclude>test/java/**/*.java</testInclude><testInclude>desktop-test/java/**/*.java</testInclude></testIncludes>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.2.5</version>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>desktop-fat-jar</id>
                                <phase>package</phase>
                                <goals><goal>shade</goal></goals>
                                <configuration>
                                    <outputFile>${project.build.directory}/maa-checker-desktop.jar</outputFile>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                                <exclude>module-info.class</exclude>
                                                <exclude>META-INF/versions/*/module-info.class</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <mainClass>yagen.waitmydawn.checker.desktop.DesktopLauncher</mainClass>
                                        </transformer>
                                    </transformers>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <version>0.0.8</version>
                        <configuration>
                            <mainClass>yagen.waitmydawn.checker.desktop.DesktopLauncher</mainClass>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          轻量 EXE 只包裹已构建的桌面 fat jar，不复制 JRE。
          由 package.ps1 在生成 ICO 后调用，因此 maa.icon 必须指向实际存在的 ICO。
        -->
        <profile>
            <id>desktop-light</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.akathist.maven.plugins.launch4j</groupId>
                        <artifactId>launch4j-maven-plugin</artifactId>
                        <version>2.5.0</version>
                        <configuration>
                            <headerType>gui</headerType>
                            <outfile>${project.build.directory}/desktop/MAA-Checker-Light.exe</outfile>
                            <jar>${project.build.directory}/desktop/maa-checker-desktop.jar</jar>
                            <dontWrapJar>false</dontWrapJar>
                            <stayAlive>true</stayAlive>
                            <restartOnCrash>false</restartOnCrash>
                            <errTitle>MAA-Checker Light</errTitle>
                            <disableVersionInfoDefaults>true</disableVersionInfoDefaults>
                            <icon>${maa.icon}</icon>
                            <jre>
                                <minVersion>21</minVersion>
                                <requires64Bit>true</requires64Bit>
                                <opts>
                                    <opt>-Dfile.encoding=UTF-8</opt>
                                    <opt>-Dstdout.encoding=UTF-8</opt>
                                    <opt>-Dstderr.encoding=UTF-8</opt>
                                </opts>
                            </jre>
                            <versionInfo>
                                <fileVersion>${project.version}.0</fileVersion>
                                <txtFileVersion>${project.version}</txtFileVersion>
                                <productVersion>${project.version}.0</productVersion>
                                <txtProductVersion>${project.version}</txtProductVersion>
                                <fileDescription>MAA-Checker Light</fileDescription>
                                <copyright>Copyright (c) 2026 Yagen</copyright>
                                <productName>MAA-Checker Light</productName>
                                <companyName>Yagen</companyName>
                                <internalName>MAA-Checker-Light</internalName>
                                <originalFilename>MAA-Checker-Light.exe</originalFilename>
                                <language>0x0804</language>
                            </versionInfo>
                            <messages>
                                <jreVersionErr>轻量版需要 Java 21 或更高版本。</jreVersionErr>
                                <jreNotFoundErr>未找到 Java 21+。请安装 Java 21，或改用自带运行时的桌面版。</jreNotFoundErr>
                                <startupErr>MAA-Checker Light 启动失败。</startupErr>
                            </messages>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
